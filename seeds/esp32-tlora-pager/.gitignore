# MeshCore identity secrets (never commit)
data/mesh_identity.id
data/mesh_pair.json
data/mesh_probe_s.txt
# Reticulum node identity, X25519 + Ed25519 private keys (never commit)
data/rns_identity.id
# Atomic-writer scratch files: the secret is written to .tmp BEFORE the rename,
# so a failed rename leaves a private key (rns_identity, gw_token) sitting here.
data/*.tmp
# WireGuard + WiFi secrets (never commit)
data/wg.json
data/wifi.json
data/auth_token.txt
# Gateway capability token + agent bridge URL (never commit)
data/gw_token.txt
data/agent_bridge.txt
