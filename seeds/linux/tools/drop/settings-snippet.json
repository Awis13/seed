{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/seeds/linux/tools/drop/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/seeds/linux/tools/drop/hooks/prompt-inject.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/seeds/linux/tools/drop/hooks/on-stop.sh"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".drop-inbox.md",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/seeds/linux/tools/drop/hooks/on-filechange.sh",
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
