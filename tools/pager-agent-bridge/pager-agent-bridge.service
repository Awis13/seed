[Unit]
Description=Pager AGENTS bridge (T-Lora ↔ Hermes API)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=awis
WorkingDirectory=/home/awis/pager-agent-bridge
EnvironmentFile=/home/awis/pager-agent-bridge/bridge.env
ExecStart=/usr/bin/python3 /home/awis/pager-agent-bridge/pager_agent_bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
